# =========================================================================
# NLAMS — National Land Acquisition & Management System
# SIH 2026 | Problem Statement #26016
# Environment Configuration Template
# =========================================================================

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration (MySQL 8/9 with mysql2)
# Set DB_TYPE to 'mysql' to strictly require MySQL, or 'auto' to auto-detect/fallback to SQLite if MySQL is offline
DB_TYPE=auto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nlams_db
DB_CONNECTION_LIMIT=10

# Security & Session Authentication
# In production, use a strong 256-bit random string
JWT_SECRET=nlams_sih_secure_jwt_secret_dev_key_2026
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Document Vault Storage (stored outside web root)
STORAGE_DIR=./storage/vault
MAX_UPLOAD_SIZE_MB=50

# Statutory & Integration Adapters (Clearly marked Demo / Sandbox)
SIGNING_PROVIDER=DEMO_NIC_DSC_ADAPTER
PAYMENT_GATEWAY=PFMS_SANDBOX_ADAPTER
SMS_EMAIL_PROVIDER=MOCK_GOV_GATEWAY
